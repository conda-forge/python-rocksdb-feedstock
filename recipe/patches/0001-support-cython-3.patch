From: conda-forge <conda-forge@users.noreply.github.com>
Subject: [PATCH] Support building with Cython 3

Cython 3 needs the package-local .pxd directory on its include path and uses
Python 3 import semantics for the generated extension. Configure the include
directory and make the runtime imports explicitly package-relative.

diff --git a/setup.py b/setup.py
index 09432dc..630cae9 100644
--- a/setup.py
+++ b/setup.py
@@ -34,6 +34,7 @@ setup(
     ext_modules=[Extension(
         'rocksdb._rocksdb',
         ['rocksdb/_rocksdb.pyx'],
+        include_dirs=['rocksdb'],
         extra_compile_args=extra_compile_args,
         language='c++',
         libraries=['rocksdb', 'snappy', 'bz2', 'z', 'lz4'],
diff --git a/rocksdb/_rocksdb.pyx b/rocksdb/_rocksdb.pyx
index d5fc6e3..179271a 100644
--- a/rocksdb/_rocksdb.pyx
+++ b/rocksdb/_rocksdb.pyx
@@ -43,13 +43,13 @@
 from status cimport Status
 
 import sys
-from interfaces import MergeOperator as IMergeOperator
-from interfaces import AssociativeMergeOperator as IAssociativeMergeOperator
-from interfaces import FilterPolicy as IFilterPolicy
-from interfaces import Comparator as IComparator
-from interfaces import SliceTransform as ISliceTransform
+from .interfaces import MergeOperator as IMergeOperator
+from .interfaces import AssociativeMergeOperator as IAssociativeMergeOperator
+from .interfaces import FilterPolicy as IFilterPolicy
+from .interfaces import Comparator as IComparator
+from .interfaces import SliceTransform as ISliceTransform
 import traceback
-import errors
+from . import errors
 import weakref
 
 ctypedef const filter_policy.FilterPolicy ConstFilterPolicy
